FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml mvnw ./
COPY .mvn .mvn
RUN mvn -B -ntp dependency:go-offline
COPY src src
RUN mvn -B -ntp -DskipTests package

FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 --home /app familypoints
WORKDIR /app
COPY --from=build /src/target/*.jar /app/family-points.jar
USER 10001
EXPOSE 8080
ENTRYPOINT ["java","-jar","/app/family-points.jar"]
