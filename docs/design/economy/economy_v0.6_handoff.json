    {
      "id": "ECO-001",
      "question": "Складність незалежно від часу",
      "proposal": "4 рівні EASY/MODERATE/HARD/ADVANCED; час лише додатковий критерій",
      "owner": "Architecture",
      "priority": "P0",
      "status": "AWAITING_DECISION"
    },
    {
      "id": "ECO-002",
      "question": "Рекомендація vs автоматична формула",
      "proposal": "За замовчуванням лише editable suggestion; зарахування за підтвердженим виконанням",
      "owner": "Architecture / Product",
      "priority": "P0",
      "status": "AWAITING_DECISION"
    },
    {
      "id": "ECO-003",
      "question": "Безкоштовність базових потреб",
      "proposal": "NULL не означає 0, покупку чи заборону; базові потреби та сімейне спілкування не монетизувати",
      "owner": "Architecture / UX",
      "priority": "P0",
      "status": "AWAITING_DECISION"
    },
    {
      "id": "ECO-004",
      "question": "Пенальті",
      "proposal": "0 за замовчуванням; ручна явна дія дорослого; окрема репутація",
      "owner": "Architecture",
      "priority": "P0",
      "status": "AWAITING_DECISION"
    },
    {
      "id": "ECO-005",
      "question": "Повторні нарахування",
      "proposal": "Idempotent occurrence+beneficiary+event; atomic ledger; offline replay",
      "owner": "Backend",
      "priority": "P0",
      "status": "AWAITING_DECISION"
    },
    {
      "id": "ECO-006",
      "question": "Багаторівневі завдання",
      "proposal": "Не дублювати бонуси parent+children за замовчуванням",
      "owner": "Backend / Product",
      "priority": "P0",
      "status": "AWAITING_DECISION"
    },
    {
      "id": "ECO-007",
      "question": "Валюти",
      "proposal": "POINTS як базова рекомендація, COPPER/SILVER/GOLD без несанкціонованих курсів",
      "owner": "Architecture",
      "priority": "P1",
      "status": "AWAITING_DECISION"
    },
    {
      "id": "ECO-008",
      "question": "Часові нагороди",
