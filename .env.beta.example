# Template only. Put real secrets in an untracked .env on the VPS (chmod 600).
# DB_PASSWORD: generate using: openssl rand -hex 32
# JWT_SECRET: MUST be BASE64 of >=32 cryptographically random bytes.
# Generate with: openssl rand -base64 48 | tr -d '\n'
# Do not copy values from DEV or commit the real .env.
DB_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_JWT_SECRET
BETA_HTTP_PORT=18080

# Public BETA at root domain until stable release; explicit opt-in flags.
FAMILYPOINTS_WEB_URL=https://family-point.com
FAMILYPOINTS_GLOBAL_ACCOUNT_REGISTRATION_ENABLED=false
FAMILYPOINTS_MEMBER_EMAIL_INVITATIONS_ENABLED=false
# OAuth public Web client ID (not Client Secret); register family-point.com JavaScript origin in Google Cloud
GOOGLE_CLIENT_ID=
FAMILYPOINTS_GOOGLE_ENABLED=false
FAMILYPOINTS_GOOGLE_REGISTRATION_ENABLED=false
FAMILYPOINTS_GOOGLE_LINKING_ENABLED=false
# Brevo SMTP: keep all credentials only in the private VPS .env
FAMILYPOINTS_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
