# Template only. Put real secrets in an untracked .env on the VPS (chmod 600).
# DB_PASSWORD: generate using: openssl rand -hex 32
# JWT_SECRET: MUST be BASE64 of >=32 cryptographically random bytes.
# Generate with: openssl rand -base64 48 | tr -d '\n'
# Do not copy values from DEV or commit the real .env.
DB_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_JWT_SECRET
BETA_HTTP_PORT=18080
